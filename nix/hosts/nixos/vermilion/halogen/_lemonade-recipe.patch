+namespace lemon {
+namespace backends {
+namespace halogen {
+
+// The halogen backend descriptor (plain data). Halogen (peonist-ai/halogen-flash-server) is a
+// Qwen3.8-Flash-Next engine for Strix Halo. Nix pins its OCI runtime
+// and points halogen.rocm_bin at a shim that starts the engine; lemonade spawns
+// the shim as its subprocess and proxies requests, exactly like the Strata
+// backend. Upstream publishes no binaries, so there is no managed install.
+inline const BackendDescriptor descriptor = {
+    /*recipe*/          "halogen",
+    /*display_name*/    "Halogen (experimental)",
+    /*binary*/          "halogen-lemond-shim",
+    /*config_section*/  "",  // defaults to recipe
+    /*default_device*/  DEVICE_GPU,
+    /*slot_policy*/     SlotPolicy::Standard,
+    /*selectable_backend*/ false,  // rocm is the only variant; no option to declare
+    /*uses_ctx_size*/   true,
+    /*dynamic_models*/  false,
+    /*options*/ {
+        {"halogen_args", "--halogen-args", "", "ARGS",
+         "Custom arguments to pass to the Halogen shim", "Halogen Options"},
+    },
+    /*support*/ {
+        {"rocm", BackendTier::Experimental, BackendFormat::Native, {"linux"}, {{"amd_gpu", {"gfx1151"}}}, "Halogen shim for AMD Strix Halo"},
+    },
+    /*supported_modes*/ {"chat"},
+    /*required_checkpoints*/ {"main"},
+    /*default_capabilities*/ {},
+    /*web_display_name*/ "",
+    /*rocm_channels*/   {},  // single rocm artifact, no stable/nightly channels
+    /*exposes_prometheus_metrics*/ false,
+    /*rocm_requires_cwsr_fix*/ true,
+    /*version_policy*/  VersionPolicy::Exact,
+    /*self_manages_downloads*/ false,
+    /*takes_args*/      true,
+    /*arg_variants*/    {},
+    /*bin_variants*/    {},
+    /*config_extra*/    nlohmann::json::object(),
+    /*streams_model_from_storage*/ true,
+};
+
+}  // namespace halogen
+}  // namespace backends
+}  // namespace lemon
--- a/src/cpp/include/lemon/backends/halogen/halogen_server.h
+++ b/src/cpp/include/lemon/backends/halogen/halogen_server.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include "lemon/wrapped_server.h"
+#include "lemon/backends/backend_registry.h"
+#include "lemon/backends/backend_utils.h"
+#include <cstdint>
+
+namespace lemon {
+namespace backends {
+
+// Wraps the Halogen shim (peonist-ai/halogen-flash-server on TheRock ROCm) as a lemonade
+// backend. The shim starts the Halogen engine and exposes an OpenAI-compatible
+// HTTP server; lemonade spawns it as a subprocess and proxies requests, exactly
+// like the other LLM backends. There is no managed install: halogen.rocm_bin is
+// pointed at the Nix-built shim.
+class HalogenServer : public WrappedServer {
+public:
+    static InstallParams get_install_params(const std::string& backend, const std::string& version);
+    HalogenServer(const std::string& log_level, ModelManager* model_manager,
+                 BackendManager* backend_manager);
+
+    void load(const std::string& model_name, const ModelInfo& model_info,
+              const RecipeOptions& options, bool do_not_upgrade = false) override;
+
+    json chat_completion(const json& request) override;
+    json responses(const json& request) override;
+};
+
+namespace halogen {
+std::unique_ptr<WrappedServer> create(const BackendContext& ctx);
+const BackendSpec* spec();
+const BackendOps* ops();
+constexpr uint32_t capabilities() { return capability_mask_of<HalogenServer>(); }
+}  // namespace halogen
+
+}  // namespace backends
+}  // namespace lemon
--- a/src/cpp/server/backends/halogen/halogen_server.cpp
+++ b/src/cpp/server/backends/halogen/halogen_server.cpp
@@ -0,0 +1,157 @@
+#include "lemon/backends/halogen/halogen_server.h"
+#include "lemon/backends/halogen/halogen.h"
+#include "lemon/backends/backend_registry.h"
+#include "lemon/backends/backend_ops.h"
+#include "lemon/backends/backend_utils.h"
+#include "lemon/model_manager.h"
+#include "lemon/utils/custom_args.h"
+#include "lemon/utils/http_client.h"
+#include <lemon/utils/aixlog.hpp>
+#include <filesystem>
+#include <set>
+#include <stdexcept>
+#include <vector>
+
+namespace fs = std::filesystem;
+using namespace lemon::utils;
+
+namespace lemon {
+namespace backends {
+
+// Halogen loads a Qwen3.8-Flash-Next MoE, so its first /v1/models can trail a
+// long GGUF read. Pass the readiness wait explicitly instead of inheriting
+// HttpClient's global_timeout: that global stays 0 so llama.cpp requests keep
+// no request cutoff, and 0 here would mean "zero readiness attempts" and fail
+// the load instantly (see noamsto/nix-amd-ai#63).
+static constexpr long kHalogenReadinessTimeoutSeconds = 3600;
+
+namespace {
+
+// Flags the shim consumes itself. Its argparse is last-wins, so a halogen_args
+// token naming one of these would override Lemonade's own model/host/port or
+// the managed context instead of being rejected by the shim's tuning allow-list.
+const std::set<std::string>& reserved_custom_arg_flags() {
+    static const std::set<std::string> flags = {
+        "-m", "--model",
+        "--host", "--port",
+        "-c", "--ctx",
+    };
+    return flags;
+}
+
+}  // namespace
+
+// No managed install: Nix provides halogen-lemond-shim and points halogen.rocm_bin
+// at it, and load() never calls install_backend(). Keep this non-null spec so
+// the generic install/availability paths still resolve the external binary.
+InstallParams HalogenServer::get_install_params(const std::string& backend, const std::string& version) {
+    (void)backend;
+    (void)version;
+    throw std::runtime_error(
+        "halogen is not a managed backend; set halogen.rocm_bin to the halogen-lemond-shim path");
+}
+
+HalogenServer::HalogenServer(const std::string& log_level, ModelManager* model_manager,
+                           BackendManager* backend_manager)
+    : WrappedServer("halogen-lemond-shim", log_level, model_manager, backend_manager) {
+}
+
+void HalogenServer::load(const std::string& model_name, const ModelInfo& model_info,
+                        const RecipeOptions& options, bool do_not_upgrade) {
+    (void)do_not_upgrade;  // nothing to install/upgrade: the binary is externally supplied
+
+    // The shim only serves the model its baked-in settings name, so resolve the
+    // same local GGUF the module registered, from either the HF-resolved path or
+    // a user_models.json absolute checkpoint.
+    std::string gguf_path = model_info.resolved_path("main");
+    if (gguf_path.empty() || !fs::exists(gguf_path)) {
+        const std::string checkpoint = model_info.checkpoint();
+        if (!checkpoint.empty() && fs::path(checkpoint).is_absolute() && fs::exists(checkpoint)) {
+            gguf_path = checkpoint;
+        }
+    }
+    if (gguf_path.empty() || !fs::exists(gguf_path)) {
+        throw std::runtime_error("halogen: no local GGUF found for model '" + model_name +
+                                 "' (checkpoint: " + model_info.checkpoint() + ")");
+    }
+
+    // rocm is the only variant, so there is no backend option to read.
+    const std::string backend = "rocm";
+    device_type_ = DEVICE_GPU;
+
+    const std::string executable = BackendUtils::find_external_backend_binary("halogen", backend);
+    if (executable.empty()) {
+        throw std::runtime_error(
+            "halogen: halogen.rocm_bin is not set (or is not a path); point it at halogen-lemond-shim");
+    }
+
+    const int ctx_size = options.get_option("ctx_size");
+    const std::string halogen_args = options.get_option("halogen_args");
+
+    port_ = choose_port();
+
+    std::vector<std::string> args;
+    args.push_back("-m");
+    args.push_back(gguf_path);
+    args.push_back("--host");
+    args.push_back("127.0.0.1");
+    args.push_back("--port");
+    args.push_back(std::to_string(port_));
+    if (ctx_size > 0) {
+        args.push_back("-c");
+        args.push_back(std::to_string(ctx_size));
+    }
+
+    if (!halogen_args.empty()) {
+        const std::string validation_error =
+            validate_custom_args(halogen_args, reserved_custom_arg_flags());
+        if (!validation_error.empty()) {
+            throw std::invalid_argument("Invalid custom halogen arguments:\n" + validation_error);
+        }
+        LOG(DEBUG, "Halogen") << "Adding custom arguments: " << halogen_args << std::endl;
+        std::vector<std::string> custom_args = parse_custom_args(halogen_args);
+        args.insert(args.end(), custom_args.begin(), custom_args.end());
+    }
+
+    LOG(INFO, "Halogen") << "Starting halogen-lemond-shim (" << executable << ") for " << gguf_path
+                        << " on port " << port_ << std::endl;
+
+    ServerCommand command;
+    command.program = executable;
+    command.args = std::move(args);
+    command.port = port_;
+    // The shim binds its port only after the engine has loaded the model, so
+    // first reachability means ready. /v1/models is the cheapest always-on route.
+    command.ready_endpoint = "/v1/models";
+
+    const bool inherit_output = (log_level_ == "info") || (log_level_ == "debug");
+    start_server(std::make_unique<NativeProcess>(ProcessOutput{inherit_output, true}), command,
+                 kHalogenReadinessTimeoutSeconds);
+}
+
+json HalogenServer::chat_completion(const json& request) {
+    return forward_request("/v1/chat/completions", request);
+}
+
+json HalogenServer::responses(const json& request) {
+    return forward_request("/v1/responses", request);
+}
+
+namespace halogen {
+
+std::unique_ptr<WrappedServer> create(const BackendContext& ctx) {
+    return make_server<HalogenServer>(ctx);
+}
+
+const BackendSpec* spec() {
+    return make_spec<HalogenServer>(descriptor);
+}
+
+const BackendOps* ops() {
+    return default_backend_ops();
+}
+
+}  // namespace halogen
+
+}  // namespace backends
+}  // namespace lemon
